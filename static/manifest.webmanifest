      "short_name": "Cotizar",
      "url": "/cotizaciones",
      "icons": [{"src": "/static/img/hsc-app-192.png", "sizes": "192x192"}]
    },
    {
      "name": "Facturación",
      "short_name": "Facturas",
      "url": "/facturacion",
      "icons": [{"src": "/static/img/hsc-app-192.png", "sizes": "192x192"}]
    },
    {
      "name": "Reportes",
      "short_name": "Reportes",
      "url": "/reportes",
      "icons": [{"src": "/static/img/hsc-app-192.png", "sizes": "192x192"}]
    }
  ]
